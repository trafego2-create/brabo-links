# Banco: Supabase comercial pelo pooler em modo transação (porta 6543).
# Sem DATABASE_URL, o app usa SQLite em data/links.db (só pra desenvolver).
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Endereço público dos links curtos (sem barra no fim)
PUBLIC_BASE=https://go.braboconcursos.com.br
# Pra onde vai quem abre um link inexistente/arquivado
FALLBACK_URL=https://braboconcursos.com.br

# Assina o cookie de login e o hash anônimo do visitante. NÃO trocar depois de no ar
# (derruba as sessões e "zera" a contagem de pessoas diferentes).
SESSION_SECRET=gere-com-python-c-import-secrets-print-secrets.token_hex-32

# Primeiro admin, criado só se não existir nenhum usuário
ADMIN_EMAIL=operacional.and@aprovasim.com
ADMIN_PASSWORD=troque-no-primeiro-acesso
